! Geometry.idf
! Stuttgart weather run with one thermal zone, six detailed surfaces (6 m x 4 m x 3 m shoebox),
! fenestration (windows) on the South and East walls, and internal gains (people, lights, equipment).

Version,26.1;

Timestep,4;

Building,
  OurModel,                !- Name
  0.0000000E+00,           !- North Axis {deg}
  Suburbs,                 !- Terrain
  0.04,                    !- Loads Convergence Tolerance Value {W}
  0.40,                    !- Temperature Convergence Tolerance Value {deltaC}
  FullInteriorAndExterior, !- Solar Distribution
  25,                      !- Maximum Number of Warmup Days
  6;                       !- Minimum Number of Warmup Days

GlobalGeometryRules,
  UpperLeftCorner,         !- Starting Vertex Position
  CounterClockWise,        !- Vertex Entry Direction
  World;                   !- Coordinate System

!--------------------------------------------------------------------
! Materials
!--------------------------------------------------------------------

Material:NoMass,
  Insulation_R2,           !- Name
  MediumRough,             !- Roughness
  2.0,                     !- Thermal Resistance {m2-K/W}
  0.9,                     !- Thermal Absorptance
  0.7,                     !- Solar Absorptance
  0.7;                     !- Visible Absorptance

Material,
  Concrete_100mm,          !- Name
  MediumRough,             !- Roughness
  0.10,                    !- Thickness {m}
  1.73,                    !- Conductivity {W/m-K}
  2243,                    !- Density {kg/m3}
  837,                     !- Specific Heat {J/kg-K}
  0.9,                     !- Thermal Absorptance
  0.65,                    !- Solar Absorptance
  0.65;                    !- Visible Absorptance

!====================================================================
! WINDOW MATERIALS
!====================================================================

!---- Existing simple glazing (kept) ----
WindowMaterial:SimpleGlazingSystem,
  SimpleGlazing_U1.8_SHGC0.6,  !- Name
  1.8,                     !- U-Factor {W/m2-K}
  0.60,                    !- Solar Heat Gain Coefficient
  0.80;                    !- Visible Transmittance

!---- NEW #1: Detailed glazing layer (6 mm clear float glass) ----
WindowMaterial:Glazing,
  ClearGlass_6mm,          !- Name
  SpectralAverage,         !- Optical Data Type
  ,                        !- Window Glass Spectral Data Set Name
  0.006,                   !- Thickness {m}
  0.850,                   !- Solar Transmittance at Normal Incidence
  0.075,                   !- Solar Reflectance at Normal Incidence: Front Side
  0.075,                   !- Solar Reflectance at Normal Incidence: Back Side
  0.900,                   !- Visible Transmittance at Normal Incidence
  0.080,                   !- Visible Reflectance at Normal Incidence: Front Side
  0.080,                   !- Visible Reflectance at Normal Incidence: Back Side
  0.000,                   !- IR Transmittance at Normal Incidence
  0.840,                   !- IR Reflectance at Normal Incidence: Front Side
  0.840,                   !- IR Reflectance at Normal Incidence: Back Side
  0.900,                   !- Conductivity {W/m-K}
  1.0,                     !- Dirt Correction Factor for Solar and Visible Transmittance
  No;                      !- Solar Diffusing

!---- NEW #2: Gas fill (13 mm air gap) ----
WindowMaterial:Gas,
  AirGap_13mm,             !- Name
  Air,                     !- Gas Type
  0.013;                   !- Thickness {m}



!--------------------------------------------------------------------
! Constructions
!--------------------------------------------------------------------

Construction,
  ExtWall,                 !- Name
  Insulation_R2;           !- Outside Layer

Construction,
  SlabFloor,               !- Name
  Concrete_100mm;          !- Outside Layer

Construction,
  ExtRoof,                 !- Name
  Insulation_R2;           !- Outside Layer

! NEW: Window construction
Construction,
  ExtWindow,               !- Name
  SimpleGlazing_U1.8_SHGC0.6;  !- Outside Layer

!--------------------------------------------------------------------
! Thermal Zone
!--------------------------------------------------------------------

Zone,
  Zone_1,                  !- Name
  0,                       !- Direction of Relative North {deg}
  0,                       !- X Origin {m}
  0,                       !- Y Origin {m}
  0,                       !- Z Origin {m}
  1,                       !- Type
  1,                       !- Multiplier
  autocalculate,           !- Ceiling Height {m}
  autocalculate;           !- Volume {m3}

!--------------------------------------------------------------------
! Building Surfaces
!--------------------------------------------------------------------

BuildingSurface:Detailed,
  Zone_1:Wall_South,       !- Name
  Wall,                    !- Surface Type
  ExtWall,                 !- Construction Name
  Zone_1,                  !- Zone Name
  ,                        !- Space Name
  Outdoors,                !- Outside Boundary Condition
  ,                        !- Outside Boundary Condition Object
  SunExposed,              !- Sun Exposure
  WindExposed,             !- Wind Exposure
  0.5,                     !- View Factor to Ground
  4,                       !- Number of Vertices
  0,0,3,                   !- Vertex 1 {m}
  0,0,0,                   !- Vertex 2 {m}
  6,0,0,                   !- Vertex 3 {m}
  6,0,3;                   !- Vertex 4 {m}

BuildingSurface:Detailed,
  Zone_1:Wall_East,        !- Name
  Wall,                    !- Surface Type
  ExtWall,                 !- Construction Name
  Zone_1,                  !- Zone Name
  ,                        !- Space Name
  Outdoors,                !- Outside Boundary Condition
  ,                        !- Outside Boundary Condition Object
  SunExposed,              !- Sun Exposure
  WindExposed,             !- Wind Exposure
  0.5,                     !- View Factor to Ground
  4,                       !- Number of Vertices
  6,0,3,                   !- Vertex 1 {m}
  6,0,0,                   !- Vertex 2 {m}
  6,4,0,                   !- Vertex 3 {m}
  6,4,3;                   !- Vertex 4 {m}

BuildingSurface:Detailed,
  Zone_1:Wall_North,       !- Name
  Wall,                    !- Surface Type
  ExtWall,                 !- Construction Name
  Zone_1,                  !- Zone Name
  ,                        !- Space Name
  Outdoors,                !- Outside Boundary Condition
  ,                        !- Outside Boundary Condition Object
  SunExposed,              !- Sun Exposure
  WindExposed,             !- Wind Exposure
  0.5,                     !- View Factor to Ground
  4,                       !- Number of Vertices
  6,4,3,                   !- Vertex 1 {m}
  6,4,0,                   !- Vertex 2 {m}
  0,4,0,                   !- Vertex 3 {m}
  0,4,3;                   !- Vertex 4 {m}

BuildingSurface:Detailed,
  Zone_1:Wall_West,        !- Name
  Wall,                    !- Surface Type
  ExtWall,                 !- Construction Name
  Zone_1,                  !- Zone Name
  ,                        !- Space Name
  Outdoors,                !- Outside Boundary Condition
  ,                        !- Outside Boundary Condition Object
  SunExposed,              !- Sun Exposure
  WindExposed,             !- Wind Exposure
  0.5,                     !- View Factor to Ground
  4,                       !- Number of Vertices
  0,4,3,                   !- Vertex 1 {m}
  0,4,0,                   !- Vertex 2 {m}
  0,0,0,                   !- Vertex 3 {m}
  0,0,3;                   !- Vertex 4 {m}

BuildingSurface:Detailed,
  Zone_1:Floor,            !- Name
  Floor,                   !- Surface Type
  SlabFloor,               !- Construction Name
  Zone_1,                  !- Zone Name
  ,                        !- Space Name
  Ground,                  !- Outside Boundary Condition
  ,                        !- Outside Boundary Condition Object
  NoSun,                   !- Sun Exposure
  NoWind,                  !- Wind Exposure
  1.0,                     !- View Factor to Ground
  4,                       !- Number of Vertices
  6,0,0,                   !- Vertex 1 {m}
  0,0,0,                   !- Vertex 2 {m}
  0,4,0,                   !- Vertex 3 {m}
  6,4,0;                   !- Vertex 4 {m}

BuildingSurface:Detailed,
  Zone_1:Roof,             !- Name
  Roof,                    !- Surface Type
  ExtRoof,                 !- Construction Name
  Zone_1,                  !- Zone Name
  ,                        !- Space Name
  Outdoors,                !- Outside Boundary Condition
  ,                        !- Outside Boundary Condition Object
  SunExposed,              !- Sun Exposure
  WindExposed,             !- Wind Exposure
  0,                       !- View Factor to Ground
  4,                       !- Number of Vertices
  0,4,3,                   !- Vertex 1 {m}
  0,0,3,                   !- Vertey 2 {m}
  6,0,3,                   !- Vertex 3 {m}
  6,4,3;                   !- Vertey 4 {m}

!--------------------------------------------------------------------
! Fenestration Surfaces (Windows)
!--------------------------------------------------------------------

! South window: 2 m wide x 1.5 m tall, sill at 0.9 m, centered on the 6 m wall.
! Parent wall Zone_1:Wall_South lies in plane y = 0, outward normal is -y.
! Vertices are listed UpperLeftCorner then CounterClockWise when viewed from outside (-y).
! Use FenestrationSurface:Detailed (not BuildingSurface:Detailed) for windows.
FenestrationSurface:Detailed,
  Zone_1:Window_South,     !- Name
  Window,                  !- Surface Type
  ExtWindow,               !- Construction Name
  Zone_1:Wall_South,       !- Building Surface Name
  ,                        !- Outside Boundary Condition Object
  0.5,                     !- View Factor to Ground
  ,                        !- Frame/Divider Name
  1.0,                     !- Multiplier
  4,                       !- Number of Vertices
  2.0, 0.0, 2.4,           !- Vertex 1 {m}  (Upper-left when viewed from outside)
  2.0, 0.0, 0.9,           !- Vertey 2 {m}
  4.0, 0.0, 0.9,           !- Vertex 3 {m}
  4.0, 0.0, 2.4;           !- Vertey 4 {m}

! East window: 2 m wide x 1.5 m tall, sill at 0.9 m, centered on the 4 m wall.
! Parent wall Zone_1:Wall_East lies in plane x = 6, outward normal is +x.
! Viewed from outside (+x), upper-left is at y = 3 (since +y goes to the right).
FenestrationSurface:Detailed,
  Zone_1:Window_East,      !- Name
  Window,                  !- Surface Type
  ExtWindow,               !- Construction Name
  Zone_1:Wall_East,        !- Building Surface Name
  ,                        !- Outside Boundary Condition Object
  0.5,                     !- View Factor to Ground
  ,                        !- Frame/Divider Name
  1.0,                     !- Multiplier
  4,                       !- Number of Vertices
  6.0, 1.0, 2.4,           !- Vertex 1 {m}  (Upper-left when viewed from outside +x)
  6.0, 1.0, 0.9,           !- Vertex 2 {m}
  6.0, 3.0, 0.9,           !- Vertex 3 {m}
  6.0, 3.0, 2.4;           !- Vertex 4 {m}

!--------------------------------------------------------------------
! Internal Gains
! People, lights, and plug loads for Zone_1 (24 m2 floor, office-type).
! Occupancy / lighting / equipment use weekday office profiles.
!--------------------------------------------------------------------

ScheduleTypeLimits,
  Fraction,                !- Name
  0.0,                     !- Lower Limit Value
  1.0,                     !- Upper Limit Value
  Continuous;              !- Numeric Type

ScheduleTypeLimits,
  Any Number;              !- Name

Schedule:Compact,
  Occupancy_Office,        !- Name
  Fraction,                !- Schedule Type Limits Name
  Through: 12/31,          !- Field 1
  For: WeekDays SummerDesignDay CustomDay1 CustomDay2,  !- Field 2
  Until: 8:00, 0.0,        !- Field 3
  Until: 11:00, 1.00,      !- Field 5
  Until: 12:00, 0.80,      !- Field 7
  Until: 13:00, 0.40,      !- Field 9
  Until: 14:00, 0.80,      !- Field 11
  Until: 18:00, 1.00,      !- Field 13
  Until: 19:00, 0.50,      !- Field 15
  Until: 24:00, 0.0,       !- Field 17
  For: Weekends WinterDesignDay Holiday,  !- Field 19
  Until: 24:00, 0.0;       !- Field 20

Schedule:Compact,
  Lights_Office,           !- Name
  Fraction,                !- Schedule Type Limits Name
  Through: 12/31,          !- Field 1
  For: WeekDays SummerDesignDay CustomDay1 CustomDay2,  !- Field 2
  Until: 8:00, 0.05,       !- Field 3
  Until: 9:00, 0.90,       !- Field 5
  Until: 10:00, 0.95,      !- Field 7
  Until: 11:00, 1.00,      !- Field 9
  Until: 12:00, 0.95,      !- Field 11
  Until: 13:00, 0.80,      !- Field 13
  Until: 14:00, 0.90,      !- Field 15
  Until: 18:00, 1.00,      !- Field 17
  Until: 19:00, 0.60,      !- Field 19
  Until: 21:00, 0.20,      !- Field 21
  Until: 24:00, 0.05,      !- Field 23
  For: Weekends WinterDesignDay Holiday,  !- Field 25
  Until: 24:00, 0.05;      !- Field 26

Schedule:Compact,
  Equipment_Office,        !- Name
  Fraction,                !- Schedule Type Limits Name
  Through: 12/31,          !- Field 1
  For: WeekDays SummerDesignDay CustomDay1 CustomDay2,  !- Field 2
  Until: 8:00, 0.02,       !- Field 3
  Until: 9:00, 0.40,       !- Field 5
  Until: 14:00, 0.90,      !- Field 7
  Until: 15:00, 0.80,      !- Field 9
  Until: 16:00, 0.70,      !- Field 11
  Until: 18:00, 0.50,      !- Field 13
  Until: 20:00, 0.30,      !- Field 15
  Until: 24:00, 0.02,      !- Field 17
  For: Weekends WinterDesignDay Holiday,  !- Field 19
  Until: 24:00, 0.20;      !- Field 20

Schedule:Compact,
  Activity_Office,         !- Name
  Any Number,              !- Schedule Type Limits Name
  Through: 12/31,          !- Field 1
  For: AllDays,            !- Field 2
  Until: 24:00, 117.0;     !- Field 3  (W/person, seated office work)

People,
  Zone_1 People,           !- Name
  Zone_1,                  !- Zone or ZoneList or Space or SpaceList Name
  Occupancy_Office,        !- Number of People Schedule Name
  People,                  !- Number of People Calculation Method
  2,                       !- Number of People
  ,                        !- People per Floor Area {person/m2}
  ,                        !- Floor Area per Person {m2/person}
  0.3,                     !- Fraction Radiant
  autocalculate,           !- Sensible Heat Fraction
  Activity_Office;         !- Activity Level Schedule Name

Lights,
  Zone_1 Lights,           !- Name
  Zone_1,                  !- Zone or ZoneList or Space or SpaceList Name
  Lights_Office,           !- Schedule Name
  Watts/Area,              !- Design Level Calculation Method
  ,                        !- Lighting Level {W}
  10.0,                    !- Watts per Floor Area {W/m2}
  ,                        !- Watts per Person {W/person}
  0.0,                     !- Return Air Fraction
  0.59,                    !- Fraction Radiant
  0.2,                     !- Fraction Visible
  0,                       !- Fraction Replaceable
  GeneralLights;           !- End-Use Subcategory

ElectricEquipment,
  Zone_1 ElecEq,           !- Name
  Zone_1,                  !- Zone or ZoneList or Space or SpaceList Name
  Equipment_Office,        !- Schedule Name
  Watts/Area,              !- Design Level Calculation Method
  ,                        !- Design Level {W}
  8.0,                     !- Watts per Floor Area {W/m2}
  ,                        !- Watts per Person {W/person}
  0.0,                     !- Fraction Latent
  0.3,                     !- Fraction Radiant
  0.0;                     !- Fraction Lost

!--------------------------------------------------------------------
! Site & Run Period
!--------------------------------------------------------------------

Site:Location,
  Stuttgart.AP_BW_DEU Design_Conditions,  !- Name
  48.69,                                  !- Latitude {deg}
  9.22,                                   !- Longitude {deg}
  1.00,                                   !- Time Zone {hr}
  391.60;                                 !- Elevation {m}

RunPeriod,
  Run Period 1,             !- Name
  1,                        !- Begin Month
  1,                        !- Begin Day of Month
  ,                         !- Begin Year
  12,                       !- End Month
  31,                       !- End Day of Month
  ,                         !- End Year
  Tuesday,                  !- Day of Week for Start Day
  Yes,                      !- Use Weather File Holidays and Special Days
  Yes,                      !- Use Weather File Daylight Saving Period
  No,                       !- Apply Weekend Holiday Rule
  Yes,                      !- Use Weather File Rain Indicators
  Yes;                      !- Use Weather File Snow Indicators

SimulationControl,
  No,                       !- Do Zone Sizing Calculation
  No,                       !- Do System Sizing Calculation
  No,                       !- Do Plant Sizing Calculation
  No,                       !- Run Simulation for Sizing Periods
  Yes,                      !- Run Simulation for Weather File Run Periods
  No,                       !- Do HVAC Sizing Simulation for Sizing Periods
  1;                        !- Maximum Number of HVAC Sizing Simulation Passes

!--------------------------------------------------------------------
! Outputs
!--------------------------------------------------------------------

Output:VariableDictionary,Regular;

Output:Variable,*,Site Outdoor Air Drybulb Temperature,Timestep;
Output:Variable,*,Site Outdoor Air Wetbulb Temperature,Timestep;
Output:Variable,*,Site Outdoor Air Dewpoint Temperature,Timestep;
Output:Variable,*,Site Solar Azimuth Angle,Timestep;
Output:Variable,*,Site Solar Altitude Angle,Timestep;
Output:Variable,*,Site Direct Solar Radiation Rate per Area,Timestep;
Output:Variable,*,Site Diffuse Solar Radiation Rate per Area,Timestep;

Output:Variable,Zone_1,Zone Mean Air Temperature,Timestep;
Output:Variable,Zone_1,Zone Air Relative Humidity,Timestep;
Output:Variable,Zone_1,Zone People Occupant Count,Timestep;
Output:Variable,Zone_1,Zone People Total Heating Rate,Timestep;
Output:Variable,Zone_1,Zone Lights Electricity Rate,Timestep;
Output:Variable,Zone_1,Zone Electric Equipment Electricity Rate,Timestep;
Output:Variable,Zone_1,Zone Total Internal Total Heating Rate,Timestep;

! NEW: window-related outputs
Output:Variable,Zone_1:Window_South,Surface Inside Face Temperature,Timestep;
Output:Variable,Zone_1:Window_South,Surface Outside Face Temperature,Timestep;
Output:Variable,Zone_1:Window_East,Surface Inside Face Temperature,Timestep;
Output:Variable,Zone_1:Window_East,Surface Outside Face Temperature,Timestep;

OutputControl:Table:Style,
  HTML;

Output:Table:SummaryReports,
  AllSummary;